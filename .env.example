# =====================================================================
#  mail-tickets — configuration
#  Copier ce fichier en .env puis compléter. Le .env n'est jamais commité.
#  (*) = obligatoire
# =====================================================================

# ---------------------------------------------------------------------
# 1. BOÎTE MAIL (IMAP)
#    Infos dans les réglages de ton client mail ou chez ton hébergeur mail
# ---------------------------------------------------------------------
# (*) Serveur IMAP, ex : mail.accen.fr ou imap.ton-hebergeur.fr
IMAP_HOST=
# Port : 993 en SSL/TLS (le plus courant), 143 en STARTTLS
IMAP_PORT=993
# true pour le port 993, false pour le port 143
IMAP_SECURE=true
# (*) Identifiant de connexion, en général l'adresse mail complète
IMAP_USER=
# (*) Mot de passe de la boîte (ou mot de passe d'application si ton hébergeur en propose)
IMAP_PASSWORD=
# Dossier relevé
IMAP_FOLDER=INBOX
# Dossier des brouillons, pour y déposer les réponses préparées.
# Vide = brouillon uniquement dans le ticket FileMaker.
# Le nom exact varie : Drafts, INBOX.Drafts, Brouillons… (lance --check pour vérifier la connexion)
IMAP_DRAFTS_FOLDER=Drafts
# Mot-clé posé sur les mails traités (pour ne jamais les traiter deux fois)
IMAP_PROCESSED_KEYWORD=TicketCree
# Seulement si --check indique « mots-clés personnalisés : non » : dossier où ranger les mails traités
IMAP_PROCESSED_FOLDER=
# Ne traite que les mails reçus à partir de cette date (AAAA-MM-JJ).
# Vide = date du premier démarrage, mémorisée dans data/etat.json
PROCESS_SINCE=
# Nombre maximum de mails par passage
MAX_PER_RUN=25
# Fréquence de relève, en minutes
POLL_INTERVAL_MINUTES=5

# ---------------------------------------------------------------------
# 2. ANALYSE DES MAILS
#    Les moteurs sont essayés dans l'ordre ; si l'un échoue (plus de crédit,
#    serveur injoignable…), le suivant prend le relais.
#      claude  = API Anthropic (payant, meilleure qualité)
#      gratuit = API compatible OpenAI (Ollama, Groq, Gemini, Mistral…)
#      regles  = tri par mots-clés, sans IA (toujours disponible, pas de brouillon)
# ---------------------------------------------------------------------
AI_ENGINES=claude,gratuit,regles
# Un moteur sans crédit ou dont la clé est refusée est mis de côté pendant ce délai (minutes)
AI_PAUSE_MINUTES=60

# --- Claude (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Seulement si la clé n'est rattachée à aucun workspace (erreur « not scoped to a workspace ») :
# identifiant du workspace (wrkspc_…), visible dans console.anthropic.com → Settings → Workspaces
ANTHROPIC_WORKSPACE_ID=

# --- Moteur gratuit (laisser vide pour ne pas l'utiliser) ---
# Décommenter UN des blocs ci-dessous. Les noms de modèles sont des exemples :
# vérifier la liste à jour chez le fournisseur.
#
# Ollama — 100 % gratuit et local, les mails ne sortent pas de ta machine.
# Installer https://ollama.com puis : ollama pull qwen2.5:7b  (≈ 8 Go de RAM conseillés)
# FREE_AI_URL=http://localhost:11434/v1
# FREE_AI_KEY=
# FREE_AI_MODEL=qwen2.5:7b
#
# Groq — offre gratuite avec quotas, clé sur https://console.groq.com
# FREE_AI_URL=https://api.groq.com/openai/v1
# FREE_AI_KEY=
# FREE_AI_MODEL=llama-3.3-70b-versatile
#
# Google Gemini — offre gratuite avec quotas, clé sur https://aistudio.google.com
# FREE_AI_URL=https://generativelanguage.googleapis.com/v1beta/openai
# FREE_AI_KEY=
# FREE_AI_MODEL=gemini-2.5-flash
#
# Mistral — offre gratuite « Experiment », clé sur https://console.mistral.ai
# FREE_AI_URL=https://api.mistral.ai/v1
# FREE_AI_KEY=
# FREE_AI_MODEL=mistral-small-latest
FREE_AI_URL=
FREE_AI_KEY=
FREE_AI_MODEL=
# Mettre false si le fournisseur refuse le paramètre response_format
FREE_AI_JSON_MODE=true
# Délai max d'une analyse (un modèle local peut être lent)
FREE_AI_TIMEOUT_SECONDS=120

# --- Réglages communs ---
# Décris ton activité, tes clients, ton ton de réponse : améliore beaucoup les brouillons
BUSINESS_CONTEXT=Support de la société Accen (location de matériel, logiciel de gestion sous FileMaker). Les réponses sont en français, vouvoiement, ton professionnel et cordial.
# \n = retour à la ligne
REPLY_SIGNATURE=Cordialement,\nLe support Accen
# Catégories proposées (doivent exister dans la liste de valeurs FileMaker si tu en utilises une)
CATEGORIES=SAV,Commercial,Facturation,Fournisseur,Administratif,Interne,Notification automatique,Spam,Autre
# Catégories pour lesquelles aucun ticket n'est créé (le mail est quand même marqué traité)
SKIP_CATEGORIES=Spam
# Taille max du mail envoyé à l'analyse (caractères)
MAX_BODY_CHARS=15000

# ---------------------------------------------------------------------
# 3. FILEMAKER (Data API)
# ---------------------------------------------------------------------
# (*) Adresse du serveur FileMaker (réseau interne)
FM_HOST=https://172.16.1.21
# Nom du fichier FileMaker, sans .fmp12
FM_DATABASE=Hotline
# Modèle utilisé par l'API
FM_LAYOUT=WEB_SAV
# (*) Identifiants, au choix :
#   FM_AUTH = en-tête complet « Basic xxxx » (la valeur de config.fmpwd des autres projets)
#   ou FM_USER + FM_PASSWORD (compte avec le privilège étendu fmrest)
FM_AUTH=
FM_USER=
FM_PASSWORD=
FM_TIMEOUT_SECONDS=30
# false = certificat auto-signé accepté (comme IS_PRODUCTION = false)
FM_VERIFY_TLS=false

# Recherche d'abord parmi les CONTACTS des clients (onglet Utilisateurs), puis dans les fiches Clients.
# Une rubrique liée s'écrit Table::Rubrique (ex : Clients::RAISON_SOCIALE) et doit être sur le modèle.
FM_CONTACTS_LAYOUT=API_Contacts
FM_CONTACTS_EMAIL_FIELDS=COURRIEL
FM_CONTACTS_NUMBER_FIELD=TIERS::CODE_CLIENT
FM_CONTACTS_COMPANY_FIELD=TIERS::RAISON_SOCIALE
# Téléphone du contact, utilisé si l'IA n'en trouve pas dans le mail
FM_CONTACTS_PHONE_FIELDS=TELEPHONE,PORTABLE

# Rattachement au client (modèle Clients), via l'adresse de l'expéditeur.
# Si aucune adresse ne correspond : client et societe restent vides.
FM_CLIENTS_LAYOUT=Clients
# Rubrique(s) contenant une adresse mail, séparées par des virgules
FM_CLIENTS_EMAIL_FIELDS=OVH_MAIL,CONTACT_PRINCIPAL_MAIL
# Rubrique du numéro client (ex : AC1301)
FM_CLIENTS_NUMBER_FIELD=CODE_CLIENT
# Rubrique du nom de la société
FM_CLIENTS_COMPANY_FIELD=RAISON_SOCIALE

# Valeurs fixes posées sur chaque ticket
TICKET_FORME=Email
TICKET_STATUT=Ouvert
TICKET_USER_INTERNE=

# ---------------------------------------------------------------------
# 4. MODE TEST
#    true = analyse et affiche le résultat sans rien écrire (ni ticket, ni brouillon, ni marquage)
# ---------------------------------------------------------------------
DRY_RUN=true
